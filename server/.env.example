# Copy this file to .env and fill in real values. Never commit .env.

# Restricted application role used by the running app (Neon pooled host, "-pooler").
# Choose the user name and a long random password here: "npm run migrate" creates
# this role if it does not exist. Do NOT create it in the Neon console, because
# console-created roles get broad privileges.
DATABASE_URL=postgresql://ccts_app:CHOOSE_A_LONG_RANDOM_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database owner connection (from the Neon console, direct host). Used only by migrations and seeds.
MIGRATION_DATABASE_URL=postgresql://neondb_owner:OWNER_PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

SENDGRID_API_KEY=
SENDGRID_VERIFIED_SENDER=

# At least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public URL of the web app, used in activation links.
APP_BASE_URL=http://localhost:5173

# Used to create database snapshots.
NEON_API_KEY=
NEON_PROJECT_ID=
# Optional. Defaults to the project's default branch.
NEON_BRANCH_ID=

# Evidence storage: a private bucket in Neon Object Storage (S3 protocol).
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-2
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=ccts-evidence
# 32 random bytes, base64. Files are encrypted with it before upload.
# If it is lost or changed, stored evidence can no longer be read: keep a safe copy.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EVIDENCE_ENCRYPTION_KEY=

# First System Administrator, created by "npm run seed:admin". Password: 8 to 72 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=

PORT=3001
